# ============================================================
# DigiDocs Mgt — 环境变量模板
# 复制为 .env 后根据实际环境修改
# ============================================================

# ---------- 基础设施 ----------

# PostgreSQL
POSTGRES_DB=digidocs_mgt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=15432

# ---------- backend-go ----------

APP_NAME=DigiDocs Mgt Go API
HTTP_ADDR=:8080
APP_ENV=development          # development | production
API_V1_PREFIX=/api/v1
DATA_BACKEND=postgres        # memory | postgres
DATABASE_URL=postgres://postgres:postgres@localhost:15432/digidocs_mgt?sslmode=disable
BACKEND_GO_PORT=18081
CODE_REPO_ROOT=/tmp/digidocs-code-repos

# 安全：生产环境必须换成高强度随机值
JWT_SECRET=dev-secret
WORKER_CALLBACK_TOKEN=replace-me

# CORS 允许的源，逗号分隔；开发环境可设为 *
CORS_ALLOW_ORIGINS=*

# 登录 / 自助注册限流（每分钟；0 关闭）
# 登录按「被尝试的账号」分桶，注册按客户端 IP 分桶。
LOGIN_RATE_LIMIT_PER_MIN=10
REGISTER_RATE_LIMIT_PER_MIN=5

# X-Forwarded-For 尾部有几段是我们自己的反向代理追加的（从后往前数）。
# 1 = 只有前端 nginx。调大就意味着多信任一段客户端可控数据，必须与真实代理链一致。
# 注意：当前公网经 frp 裸 TCP 隧道进来，真实客户端 IP 在到达 nginx 前就已丢失，
# 调这个值救不回来——需要先让隧道传递客户端地址（PROXY protocol）。
TRUSTED_PROXY_DEPTH=1

# 通知外发通道（2026-11-10，可选；留空即只用站内通知）
# PUBLIC_BASE_URL 用于外发消息里的跳转链接，例如 https://docs.example.org
PUBLIC_BASE_URL=
# 群机器人：NOTIFY_WEBHOOK_KIND 取 wecom（企业微信）/ dingtalk（钉钉）/ generic（通用 JSON）。
# URL 内含机器人密钥，按密钥管理，不要提交到仓库。
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_KIND=wecom
# 邮件：端口 465 走隐式 TLS，其余端口在服务器支持时走 STARTTLS。只发给填写了邮箱的用户。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Storage backend: memory | synology
STORAGE_BACKEND=memory

# Synology DSM connection (required when STORAGE_BACKEND=synology)
# P14s 与群晖在同一局域网时，建议填写群晖 LAN IP / 内网 DNS，而不是 Tailscale 100.x 地址。
SYNOLOGY_HOST=
SYNOLOGY_PORT=5000
SYNOLOGY_HTTPS=false
SYNOLOGY_INSECURE_SKIP_VERIFY=false
SYNOLOGY_ACCOUNT=
SYNOLOGY_PASSWORD=
SYNOLOGY_SHARE_PATH=/DigiDocs

# ---------- backend-py-worker ----------

WORKER_NAME=digidocs-py-worker
WORKER_MODE=local            # local | distributed
OPENCLAW_BASE_URL=http://localhost:18789
# 使用 docker-compose.p14s.yml 时，会优先读取以下 P14S_* 覆盖值。
P14S_OPENCLAW_BASE_URL=http://127.0.0.1:18789
P14S_CALLBACK_BASE_URL=http://127.0.0.1:18081
OPENCLAW_API_KEY=replace-me
OPENCLAW_MODEL=openclaw/default
OPENCLAW_BACKEND_MODEL=
OPENCLAW_TIMEOUT_SECONDS=180
OPENCLAW_SKILLS_ASSISTANT_ASK=answer_with_context
OPENCLAW_SKILLS_DOCUMENT_SUMMARIZE=document_summary
OPENCLAW_SKILLS_HANDOVER_SUMMARIZE=handover_summary
OPENCLAW_SKILLS_GENERATE_SUGGESTION=structured_suggestion
CALLBACK_BASE_URL=http://localhost:8080
CALLBACK_TOKEN=replace-me      # 建议与 WORKER_CALLBACK_TOKEN 保持一致
POLL_INTERVAL=5
WORKER_CONCURRENCY=3           # 单个 worker 进程内并发处理的任务数
MAX_OCR_PAGES=30                # 扫描 PDF 自动 OCR 的页数上限，超出直接报错而不是跑到超时

# ---------- Frontend ----------

FRONTEND_PORT=18080
VITE_API_BASE_URL=http://localhost:18081/api/v1

# ---------- 烟测隔离栈（docker-compose.smoke.yml） ----------
# 烟测会写入一次性数据，因此跑在完全独立的一套栈上，不碰演示/生产环境。
# 起栈：scripts/codex/smoke-stack.sh up   跑测：make smoke   销毁：... down
SMOKE_POSTGRES_PORT=15433
SMOKE_BACKEND_GO_PORT=18083
SMOKE_FRONTEND_PORT=18082
# 与演示栈使用不同密钥，避免任一侧令牌在另一侧可用（烟测专用，无需高强度）。
SMOKE_JWT_SECRET=smoke-only-not-a-real-secret
SMOKE_WORKER_CALLBACK_TOKEN=smoke-only-worker-token

# AI 上下文与流式（2026-11-10）
# 新版本正文抽取成功后自动摘要（会多一次模型调用）
AUTO_SUMMARIZE_ON_UPLOAD=true
# Worker：单次提示词正文上限（字符）、长文摘要最多分段数、问答流式与回传间隔（秒）
MAX_CONTEXT_CHARS=12000
MAX_SUMMARY_SECTIONS=6
STREAM_ANSWERS=true
PROGRESS_INTERVAL=1.0

# 安全与运维（2026-11-10）
# 自助注册：open（任何人）/ invite_only（须凭课题邀请链接）/ closed（只能由管理员开通）
SELF_REGISTRATION=open
# 设置后开启 GET /metrics（Bearer 访问）；留空则关闭
METRICS_TOKEN=

# 模型端点（2026-11-10）：推荐直连本地 Qwen（经 digidocs-llm-bridge），不经过个人 OpenClaw 智能体。
# OPENCLAW_BASE_URL=http://172.29.0.1:11501
# OPENCLAW_MODEL=qwen3.8:27b
# 合并进每次对话请求的 JSON，直连 Qwen 时关闭思考模式以降低延迟：
LLM_EXTRA_BODY=
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
